# Demonstration of list testing framework
# Use help command to see list of commands and options
# Initial list is NULL.
show
# Create empty list
new
# Fill it with some values.  First at the head
ih dolphin
ih bear
ih gerbil
# Now at the tail
it meerkat
it bear
# Reverse it
reverse
# See how long it is
size
# Delete list.  Goes back to a NULL list.
free
# Exit program
quit
